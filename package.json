{
  "name": "ghl-mcp-server",
  "version": "0.1.0",
  "description": "Full-coverage GoHighLevel MCP server generated from HighLevel's official OpenAPI specs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "bin": {
    "ghl-mcp-server": "dist/src/stdio.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "specs:fetch": "node --experimental-strip-types scripts/fetch-specs.ts",
    "generate": "node --experimental-strip-types src/generator/cli.ts",
    "start": "node --env-file-if-exists=.env dist/src/stdio.js",
    "start:http": "node --env-file-if-exists=.env dist/src/http.js",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/stdio.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
