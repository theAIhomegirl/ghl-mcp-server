# Private Integration Token from GHL: Settings -> Private Integrations (sub-account level).
GHL_API_KEY=
# Default sub-account. Injected into any endpoint that takes locationId when the caller omits it.
GHL_LOCATION_ID=

# Which spec modules to expose as tools. Comma-separated, or "all". See `npm run generate` output for names.
GHL_MODULES=contacts,conversations,opportunities,calendars,locations

# Safety gates. Tools in a disabled class are hidden from the client and blocked at call time.
GHL_ALLOW_WRITES=false
GHL_ALLOW_DELETES=false

# Expose ghl_search_endpoints / ghl_describe_endpoint / ghl_call_endpoint covering every endpoint.
# These reach every module, not just the ones in GHL_MODULES. Only the gates above limit what they can do.
GHL_META_TOOLS=true

# List endpoints HighLevel has marked deprecated as dedicated tools. They stay reachable
# through ghl_call_endpoint either way.
GHL_INCLUDE_DEPRECATED=false

# Optional API host override. Must stay on leadconnectorhq.com over https: every request
# carries your Private Integration Token, so any other host would receive it.
# GHL_BASE_URL=https://services.leadconnectorhq.com

# HTTP transport only (npm run start:http). Clients must send "Authorization: Bearer <MCP_AUTH_TOKEN>".
MCP_AUTH_TOKEN=
PORT=3000
# Loopback by default. Anything else puts a full-CRM proxy on the network: put TLS in front of it first.
MCP_BIND_HOST=127.0.0.1
# Extra Host headers to accept, comma-separated. Needed when a reverse proxy forwards its own hostname.
MCP_ALLOWED_HOSTS=

# Optional: lifts GitHub's unauthenticated rate limit for `npm run specs:fetch`.
GITHUB_TOKEN=
