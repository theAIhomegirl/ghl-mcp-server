    {
      "name": "agent_studio_getagents",
      "module": "agent-studio",
      "method": "GET",
      "path": "/agent-studio/agent",
      "version": "2021-04-15",
      "summary": "List Agents",
      "description": "List Agents Lists all active agents for the specified location. locationId is required parameter to ensure optimal performance. Supports pagination using limit and offset. Optionally filter by isPublished=true to return only agents with a published production version. [GET /agent-studio/agent] Token: location. Scopes: agent-studio.readonly.",
      "scopes": [
        "agent-studio.readonly"
      ],
      "access": "location",
      "operationClass": "read",
      "deprecated": false,
      "pathFields": [],
      "queryFields": [
        "locationId",
        "isPublished",
        "limit",
        "offset",
        "source"
      ],
      "bodyFields": [],
      "bodyWrapped": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "locationId": {
            "type": "string"
          },
          "isPublished": {
            "type": "string",
            "description": "Optional filter to return only agents with a published production version"
          },
          "limit": {
            "type": "string"
          },
          "offset": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "locationId",
          "limit",
          "offset"
        ]
      }
    },
    {
      "name": "agent_studio_createagent",
      "module": "agent-studio",
      "method": "POST",
      "path": "/agent-studio/agent",
      "version": "2021-04-15",
      "summary": "Create Agent",
      "description": "Create Agent Creates a new agent with staging version. The agent will be created with an initial staging version that can later be promoted to production. [POST /agent-studio/agent] Token: location. Scopes: agent-studio.write.",
      "scopes": [
        "agent-studio.write"
      ],
      "access": "location",
      "operationClass": "write",
      "deprecated": false,
      "contentType": "application/json",
      "pathFields": [],
      "queryFields": [
        "source"
      ],
      "bodyFields": [
        "locationId",
        "name",
        "description",
        "agencyId",
        "authorId",
        "authorName",
        "authorEmail",
        "status",
        "version",
        "nodes",
        "edges"
      ],
      "bodyWrapped": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "locationId": {
            "type": "string",
            "description": "Location ID"
          },
          "name": {
            "type": "string",
            "description": "Name of the agent"
          },
          "description": {
            "type": "string",
            "description": "Description of the agent"
          },
          "agencyId": {
            "type": "string",
            "description": "Agency ID"
          },
          "authorId": {
            "type": "string",
            "description": "Author ID"
          },
          "authorName": {
            "type": "string",
            "description": "Author name"
          },
          "authorEmail": {
            "type": "string",
            "description": "Author email"
          },
          "status": {
            "type": "string",
            "description": "Status of the agent",
            "enum": [
              "active",
              "inactive",
              "archived"
            ]
          },
          "version": {
            "type": "object",
            "description": "Version data for the agent including nodes, edges, and configuration"
          },
          "nodes": {
            "description": "Nodes array (deprecated, prefer using version.nodes)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "edges": {
            "description": "Edges array (deprecated, prefer using version.edges)",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "locationId",
          "status",
          "version"
        ]
