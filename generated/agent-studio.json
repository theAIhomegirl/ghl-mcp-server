      "bodyWrapped": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string"
          },
          "locationId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "agentId",
          "locationId"
        ]
      }
    },
