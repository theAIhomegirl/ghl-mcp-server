      "bodyWrapped": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "locationId": {
            "type": "string",
            "description": "Your Sub Account's ID"
          },
          "associationId": {
            "type": "string",
            "description": "Association's Id"
          },
          "firstRecordId": {
            "type": "string",
