{
  "module": "emails",
  "endpoints": [
    {
      "name": "emails_fetch_campaigns",
      "module": "emails",
      "method": "GET",
      "path": "/emails/schedule",
      "version": "2021-07-28",
      "summary": "Get Campaigns",
      "description": "Get Campaigns [GET /emails/schedule] Token: location. Scopes: emails/schedule.readonly.",
      "scopes": [
        "emails/schedule.readonly"
      ],
      "access": "location",
      "operationClass": "read",
      "deprecated": false,
      "pathFields": [],
      "queryFields": [
        "locationId",
        "limit",
        "offset",
        "status",
        "emailStatus",
        "name",
        "parentId",
        "limitedFields",
        "archived",
        "campaignsOnly",
        "showStats"
      ],
      "bodyFields": [],
      "bodyWrapped": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "locationId": {
            "type": "string",
            "description": "Location ID to fetch campaigns from"
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of campaigns to return. Defaults to 10, maximum is 100"
          },
          "offset": {
            "type": "number",
            "description": "Number of campaigns to skip for pagination"
          },
          "status": {
            "enum": [
              "active",
              "pause",
              "complete",
              "cancelled",
              "retry",
              "draft",
              "resend-scheduled"
            ],
            "type": "string",
            "description": "(default: \"active\")"
          },
          "emailStatus": {
            "enum": [
              "all",
              "not-started",
              "paused",
              "cancelled",
              "processing",
              "resumed",
              "next-drip",
              "complete",
              "success",
              "error",
              "waiting",
              "queued",
              "queueing",
              "reading",
              "scheduled"
            ],
            "type": "string",
            "description": "(default: \"complete\")"
          },
          "name": {
            "type": "string",
            "description": "Filter campaigns by name"
          },
          "parentId": {
            "type": "string",
            "description": "Filter campaigns by parent folder ID"
          },
          "limitedFields": {
            "type": "boolean",
            "description": "When true, returns only essential campaign fields like id, templateDataDownloadUrl, updatedAt, type, templateType, templateId, downloadUrl and isPlainText. When false, returns complete campaign data including meta information, bulkRequestStatusInfo, ABTestInfo, resendScheduleInfo and all other camp…"
          },
          "archived": {
            "type": "boolean",
            "description": "Filter archived campaigns"
          },
          "campaignsOnly": {
            "type": "boolean",
            "description": "Return only campaigns, excluding folders"
          },
          "showStats": {
            "type": "boolean",
            "description": "When true, returns campaign statistics including delivered count, opened count, clicked count and revenue if available for the campaign. When false, returns campaign data without statistics."
          }
        },
        "required": [
          "locationId"
        ]
      }
    },
